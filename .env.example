# Шаблон настроек. Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в GitHub не попадает (см. .gitignore), а этот шаблон — попадает.

# --- База данных ---
# Локально: SQLite-файл bot.db в папке проекта (ничего устанавливать не нужно).
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# На сервере (Docker) будет так:
# DATABASE_URL=postgresql+asyncpg://bot:пароль@db:5432/bot

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Jivo ---
# provider_id выдаёт Jivo (один на весь наш сервис).
JIVO_PROVIDER_ID=
# Адрес, куда мы отправляем ответы. Для локальной проверки с симулятором:
# JIVO_API_BASE=http://127.0.0.1:9000/webhooks
JIVO_API_BASE=https://bot.jivosite.com/webhooks

# --- Админка ---
# Секрет для доступа к /admin. Придумайте длинную случайную строку.
ADMIN_TOKEN=

# --- Только для сервера (docker-compose) ---
# Пароль базы данных PostgreSQL.
POSTGRES_PASSWORD=
# Ваш домен, например bot.example.ru (нужен для HTTPS).
DOMAIN=

# --- Прочее ---
LOG_LEVEL=INFO
